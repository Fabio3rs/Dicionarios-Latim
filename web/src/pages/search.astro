---
import Layout from "../components/Layout.astro";
import FiltersPanel from "../components/FiltersPanel.astro";
import "../styles/base.css";

const base = import.meta.env.BASE_URL || "/Dicionarios-Latim";
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const dataBase = `${baseWithSlash}data`;
---

<Layout
  title="Consultar | Dicionários"
  description="Consulte lemas latinos e pesquise nas definições dos dicionários."
  breadcrumbs={[{ label: "Início", href: baseWithSlash }, { label: "Consultar" }]}
>
  <section class="dictionary-search-panel panel" aria-labelledby="search-heading">
    <div class="dictionary-search-copy">
      <p class="eyebrow">Dicionário latim–português</p>
      <h1 id="search-heading">Que palavra você procura?</h1>
      <p class="muted">Digite um lema latino. A entrada exata aparece primeiro; definições e formas relacionadas vêm depois.</p>
    </div>

    <form id="search-form" class="dictionary-search-form" role="search">
      <label class="sr-only" for="search-box">Lema ou palavra da definição</label>
      <input
        id="search-box"
        class="input dictionary-search-input"
        name="term"
        type="search"
        placeholder="Ex.: amo, bellum, sum…"
        list="suggestions"
        enterkeyhint="search"
        autocomplete="off"
        autofocus
      />
      <datalist id="suggestions"></datalist>
      <button class="button dictionary-search-button" type="submit">Consultar</button>
    </form>
  </section>

  <div class="layout-grid dictionary-layout">
    <FiltersPanel loading={true} />

    <section aria-label="Resultados" class="panel results-panel">
      <header class="results-header">
        <div>
          <p class="eyebrow results-header-label">Consulta</p>
          <h2 id="results-title" class="results-header-title">Índice alfabético</h2>
          <p id="results-summary" class="muted results-summary" aria-live="polite">Carregando índice…</p>
        </div>
        <div class="results-controls">
          <label for="page-size" class="muted page-size-label">Por página</label>
          <select id="page-size" class="input page-size-select">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
      </header>

      <section
        id="morphology-panel"
        class="morphology-panel"
        aria-labelledby="morphology-title"
        aria-live="polite"
        hidden
      >
        <div class="morphology-header">
          <div>
            <p class="eyebrow morphology-label">Analisador morfológico</p>
            <h3 id="morphology-title" class="morphology-title">Identificando a forma latina</h3>
          </div>
          <span id="morphology-state" class="morphology-state">Carregando</span>
        </div>
        <p id="morphology-summary" class="muted morphology-summary"></p>
        <div id="morphology-results" class="morphology-results"></div>
      </section>

      <div id="results" class="results-list" aria-live="polite" aria-atomic="false">
        <div class="loading-state" role="status"><span class="loading-dot" aria-hidden="true"></span> Preparando o dicionário…</div>
      </div>
    </section>
  </div>

  <script type="module" define:vars={{ baseWithSlash, dataBase }}>
    const assetBase = baseWithSlash;
    const dataBaseUrl = dataBase;
    const basePath = assetBase.endsWith("/") ? assetBase.slice(0, -1) : assetBase;

    const resultsEl = document.getElementById("results");
    const resultsTitle = document.getElementById("results-title");
    const resultsSummary = document.getElementById("results-summary");
    const searchForm = document.getElementById("search-form");
    const searchBox = document.getElementById("search-box");
    const pageSizeSel = document.getElementById("page-size");
    const filtersRoot = document.querySelector("aside[aria-label='Filtros']");
    const datalist = document.getElementById("suggestions");
    const morphologyPanel = document.getElementById("morphology-panel");
    const morphologyTitle = document.getElementById("morphology-title");
    const morphologyState = document.getElementById("morphology-state");
    const morphologySummary = document.getElementById("morphology-summary");
    const morphologyResults = document.getElementById("morphology-results");

    let letterNodes = [];
    let morfNodes = [];
    let allLemmas = [];
    let volumes = [];
    let renderSequence = 0;
    let debounceTimer = null;
    let pagefindPromise = null;
    let morphologyWorker = null;
    let morphologyReady = false;
    let morphologyUnavailable = false;
    let morphologyRequestId = 0;
    const morphologyCache = new Map();
    const morphologyPending = new Map();

    const state = {
      term: "",
      pageSize: 25,
      page: 1,
      filters: {},
    };

    function normalizeLemma(value) {
      return String(value || "")
        .normalize("NFD")
        .replace(/\p{M}+/gu, "")
        .toLocaleLowerCase("la")
        .replace(/\s+/g, " ")
        .trim();
    }

    function morphologyKey(value) {
      return String(value || "")
        .normalize("NFC")
        .toLocaleLowerCase("la")
        .replace(/\s+/g, " ")
        .trim();
    }

    function isMorphologyCandidate(value) {
      const term = morphologyKey(value);
      return term.length > 0 && term.length <= 64 &&
        term.split(" ").length <= 2 && /^[\p{L}\p{M}'’-]+(?:\s+[\p{L}\p{M}'’-]+)?$/u.test(term);
    }

    const morphologyLabels = {
      partOfSpeech: {
        noun: "substantivo",
        verb: "verbo",
        adjective: "adjetivo",
        adverb: "advérbio",
        pronoun: "pronome",
        preposition: "preposição",
        conjunction: "conjunção",
        interjection: "interjeição",
        numeral: "numeral",
        participle: "particípio",
        supine: "supino",
      },
      case: {
        nominative: "nominativo",
        genitive: "genitivo",
        dative: "dativo",
        accusative: "acusativo",
        ablative: "ablativo",
        vocative: "vocativo",
        locative: "locativo",
      },
      number: {singular: "singular", plural: "plural"},
      gender: {masculine: "masculino", feminine: "feminino", neuter: "neutro", common: "comum"},
      tense: {
        present: "presente",
        imperfect: "imperfeito",
        future: "futuro",
        perfect: "perfeito",
        pluperfect: "mais-que-perfeito",
        "future-perfect": "futuro perfeito",
      },
      voice: {active: "voz ativa", passive: "voz passiva"},
      mood: {
        indicative: "indicativo",
        subjunctive: "subjuntivo",
        imperative: "imperativo",
        infinitive: "infinitivo",
        participle: "particípio",
      },
      degree: {positive: "grau positivo", comparative: "comparativo", superlative: "superlativo"},
    };

    function translated(group, value) {
      return morphologyLabels[group]?.[value] || String(value || "").replaceAll("-", " ");
    }

    function morphologyDescription(morphology) {
      const parts = [];
      if (morphology.declension) parts.push(`${morphology.declension}ª declinação`);
      if (morphology.conjugation) parts.push(`${morphology.conjugation}ª conjugação`);
      ["case", "number", "gender", "tense", "voice", "mood", "degree"].forEach((key) => {
        if (morphology[key]) parts.push(translated(key, morphology[key]));
      });
      if (morphology.person) parts.push(`${morphology.person}ª pessoa`);
      return [...new Set(parts)].join(" · ") || "forma reconhecida";
    }

    function analysisItems(analysisDocument) {
      const items = [...(analysisDocument?.hits || [])];
      (analysisDocument?.suggestions || []).forEach((suggestion) => {
        (suggestion.segments || []).forEach((segment) => items.push(...(segment.hits || [])));
      });
      return items;
    }

    function extractMorphologyLemmas(analysisDocument) {
      const seen = new Set();
      return analysisItems(analysisDocument).flatMap((analysis) => {
        const label = String(analysis.lemma || "").trim();
        const key = normalizeLemma(label);
        if (!key || seen.has(key)) return [];
        seen.add(key);
        return [{key, label}];
      });
    }

    function setMorphologyLoading(term) {
      morphologyPanel.hidden = false;
      morphologyTitle.textContent = `Analisando “${term}”`;
      morphologyState.textContent = morphologyReady ? "Analisando" : "Carregando";
      morphologyState.className = "morphology-state morphology-state--loading";
      morphologySummary.textContent = morphologyReady
        ? "Identificando a forma e os lemas antes de ampliar a consulta…"
        : "O analisador carrega em segundo plano. A pesquisa no dicionário continua disponível.";
      morphologyResults.replaceChildren();
    }

    function setMorphologyUnavailable(term) {
      if (!isMorphologyCandidate(term)) return;
      morphologyPanel.hidden = false;
      morphologyTitle.textContent = "Análise morfológica indisponível";
      morphologyState.textContent = "Opcional";
      morphologyState.className = "morphology-state morphology-state--muted";
      morphologySummary.textContent = "A consulta principal continua funcionando normalmente pelo índice do dicionário.";
      morphologyResults.replaceChildren();
    }

    function renderMorphology(analysisDocument, lemmas, term) {
      morphologyPanel.hidden = false;
      morphologyTitle.textContent = `Análise de “${term}”`;
      morphologyResults.replaceChildren();

      const items = analysisItems(analysisDocument);
      if (analysisDocument?.status !== "analyzed" || items.length === 0) {
        morphologyState.textContent = "Não identificada";
        morphologyState.className = "morphology-state morphology-state--muted";
        morphologySummary.textContent = "Nenhuma forma latina foi reconhecida. A pesquisa textual continua abaixo.";
        return;
      }

      morphologyState.textContent = "Identificada";
      morphologyState.className = "morphology-state morphology-state--ready";
      const lemmaNames = lemmas.map(({label}) => label);
      morphologySummary.textContent = lemmaNames.length
        ? `${items.length} ${items.length === 1 ? "leitura possível" : "leituras possíveis"}. ` +
          `O Pagefind também pesquisa ${lemmaNames.length === 1 ? "o lema" : "os lemas"} ${lemmaNames.join(", ")}.`
        : `${items.length} ${items.length === 1 ? "leitura possível" : "leituras possíveis"}, sem lema lexical para ampliar a pesquisa.`;

      const groups = new Map();
      items.forEach((analysis) => {
        const lemma = analysis.lemma || (analysis.artificial ? `Número romano ${analysis.artificial.value}` : "Forma reconhecida");
        const groupKey = `${analysis.partOfSpeech}:${analysis.lexemeId ?? lemma}`;
        if (!groups.has(groupKey)) groups.set(groupKey, {lemma, partOfSpeech: analysis.partOfSpeech, forms: []});
        const description = morphologyDescription(analysis.morphology || {});
        const group = groups.get(groupKey);
        if (!group.forms.includes(description)) group.forms.push(description);
      });

      [...groups.values()].slice(0, 6).forEach((group) => {
        const card = document.createElement("article");
        card.className = "morphology-card";
        const cardHeader = document.createElement("div");
        cardHeader.className = "morphology-card-header";
        const heading = document.createElement("h4");
        heading.textContent = group.lemma;
        const badge = document.createElement("span");
        badge.className = "badge";
        badge.textContent = translated("partOfSpeech", group.partOfSpeech);
        cardHeader.append(heading, badge);
        const forms = document.createElement("ul");
        forms.className = "morphology-forms";
        group.forms.slice(0, 6).forEach((description) => {
          const item = document.createElement("li");
          item.textContent = description;
          forms.appendChild(item);
        });
        if (group.forms.length > 6) {
          const item = document.createElement("li");
          item.className = "muted";
          item.textContent = `mais ${group.forms.length - 6} possibilidades`;
          forms.appendChild(item);
        }
        card.append(cardHeader, forms);
        morphologyResults.appendChild(card);
      });
    }

    function startMorphologyWorker() {
      if (morphologyWorker || morphologyUnavailable) return morphologyWorker;
      try {
        morphologyWorker = new Worker(`${assetBase}words/analysis-worker.mjs`, {
          type: "module",
          name: "words-morphology",
        });
        morphologyWorker.addEventListener("message", handleMorphologyMessage);
        morphologyWorker.addEventListener("error", (event) => {
          event.preventDefault();
          morphologyUnavailable = true;
          morphologyWorker?.terminate();
          morphologyWorker = null;
          setMorphologyUnavailable(state.term.trim());
        });
        morphologyWorker.postMessage({type: "init", assetBase: `${assetBase}words/`});
      } catch {
        morphologyUnavailable = true;
      }
      return morphologyWorker;
    }

    function requestMorphology(term) {
      const key = morphologyKey(term);
      if (!isMorphologyCandidate(term)) {
        morphologyPanel.hidden = true;
        return;
      }
      if (morphologyCache.has(key)) {
        const cached = morphologyCache.get(key);
        renderMorphology(cached.document, cached.lemmas, term);
        return;
      }
      if (morphologyUnavailable) {
        setMorphologyUnavailable(term);
        return;
      }

      setMorphologyLoading(term);
      const worker = startMorphologyWorker();
      if (!worker || morphologyPending.has(key)) return;
      const requestId = ++morphologyRequestId;
      morphologyPending.set(key, requestId);
      worker.postMessage({type: "analyze", requestId, term, assetBase: `${assetBase}words/`});
    }

    function handleMorphologyMessage(event) {
      const message = event.data || {};
      if (message.type === "ready") {
        morphologyReady = true;
        if (isMorphologyCandidate(state.term) && !morphologyCache.has(morphologyKey(state.term))) {
          setMorphologyLoading(state.term.trim());
        }
        return;
      }
      if (message.type === "unavailable") {
        morphologyUnavailable = true;
        setMorphologyUnavailable(state.term.trim());
        return;
      }
      if (message.type === "analysis-error") {
        morphologyPending.delete(morphologyKey(message.term));
        if (morphologyKey(message.term) === morphologyKey(state.term)) setMorphologyUnavailable(state.term.trim());
        return;
      }
      if (message.type !== "analysis") return;

      const key = morphologyKey(message.term);
      morphologyPending.delete(key);
      const lemmas = extractMorphologyLemmas(message.document);
      morphologyCache.set(key, {document: message.document, lemmas});
      if (key !== morphologyKey(state.term)) return;
      renderMorphology(message.document, lemmas, state.term.trim());
      if (lemmas.length > 0) render({preserveResults: true});
    }

    async function fetchJSON(url) {
      const response = await fetch(url);
      if (!response.ok) throw new Error(`Erro ${response.status} em ${url}`);
      return response.json();
    }

    function qsParamsToState() {
      const params = new URLSearchParams(window.location.search);
      state.term = params.get("term") || "";
      state.pageSize = parseInt(params.get("pageSize") || "25", 10) || 25;
      state.page = parseInt(params.get("page") || "1", 10) || 1;
      ["volume_id", "morfologia", "first_letter", "conf", "needs_review"].forEach((key) => {
        const values = params.getAll(key);
        if (values.length) state.filters[key] = values;
      });
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (state.term.trim()) params.set("term", state.term.trim());
      if (state.pageSize !== 25) params.set("pageSize", String(state.pageSize));
      if (state.page > 1) params.set("page", String(state.page));
      Object.entries(state.filters).forEach(([key, values]) => {
        values.forEach((value) => params.append(key, value));
      });
      const query = params.toString();
      window.history.replaceState({}, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
    }

    qsParamsToState();
    searchBox.value = state.term;
    pageSizeSel.value = String(state.pageSize);

    function ensurePagefind() {
      if (!pagefindPromise) {
        pagefindPromise = import(`${assetBase}pagefind/pagefind.js`)
          .then(async (mod) => {
            const pagefind = mod?.default || mod?.pagefind || mod;
            await pagefind.options({
              excerptLength: 24,
              ranking: {
                termSimilarity: 1,
                termSaturation: 0.25,
                termFrequency: 0.8,
              },
            });
            pagefind.init?.();
            return pagefind;
          })
          .catch((error) => {
            pagefindPromise = null;
            throw error;
          });
      }
      return pagefindPromise;
    }

    function normalizeUrl(raw) {
      if (!raw) return "#";
      if (/^https?:\/\//i.test(raw)) return raw;
      let path = raw.trim();
      const baseNoSlash = basePath.replace(/^\//, "");
      for (const prefix of [basePath, `${basePath}/`, baseNoSlash, `${baseNoSlash}/`]) {
        while (path.startsWith(prefix)) path = path.slice(prefix.length);
      }
      if (!path.startsWith("/")) path = `/${path}`;
      return `${basePath}${path}`;
    }

    function filterExpression(extra = {}) {
      const conditions = Object.entries({ ...state.filters, ...extra })
        .filter(([, values]) => values?.length)
        .map(([key, values]) => {
          if (values.length === 1) return { [key]: values[0] };
          return { any: values.map((value) => ({ [key]: value })) };
        });

      if (conditions.length === 0) return undefined;
      if (conditions.length === 1) return conditions[0];
      return { all: conditions };
    }

    function createSection(title, body) {
      const section = document.createElement("section");
      const heading = document.createElement("h3");
      heading.className = "filter-section-title";
      heading.textContent = title;
      section.append(heading, body);
      return section;
    }

    async function loadSuggestions(volumeId) {
      try {
        allLemmas = await fetchJSON(`${assetBase}data/${volumeId}/dict/lemmas-suggest.json`);
      } catch {
        const fallback = await fetchJSON(`${assetBase}data/${volumeId}/dict/lemmas-top.json`);
        allLemmas = (fallback.items || []).map((item) => item.label);
      }
      updateSuggestions();
    }

    async function loadFilters() {
      try {
        volumes = await fetchJSON(`${dataBaseUrl}/volumes.json`);
        const selectedVolume = state.filters.volume_id?.[0] || "";
        const dataVolume = selectedVolume || (volumes[0]?.volume_id ?? volumes[0]?.id);

        const volumeSelect = document.createElement("select");
        volumeSelect.className = "input";
        volumeSelect.id = "volume-select";
        if (volumes.length > 1) {
          const allOption = document.createElement("option");
          allOption.value = "";
          allOption.textContent = "Todos os dicionários";
          volumeSelect.appendChild(allOption);
        }
        volumes.forEach((volume) => {
          const option = document.createElement("option");
          option.value = volume.volume_id ?? volume.id;
          option.textContent = volume.title || option.value;
          volumeSelect.appendChild(option);
        });
        volumeSelect.value = selectedVolume || (volumes.length === 1 ? dataVolume : "");

        const morphology = await fetchJSON(`${assetBase}data/${dataVolume}/dict/morfologia.json`);
        const morphologyWrap = document.createElement("div");
        morphologyWrap.className = "filter-options filter-options--scroll";
        morphology.forEach((value) => {
          const label = document.createElement("label");
          label.className = "check-option";
          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.name = "morfologia";
          checkbox.value = value;
          checkbox.checked = state.filters.morfologia?.includes(value) || false;
          label.append(checkbox, document.createTextNode(value));
          morphologyWrap.appendChild(label);
        });

        const confidenceSelect = document.createElement("select");
        confidenceSelect.className = "input";
        [
          ["", "Qualquer nível"],
          ["conf:high", "Alta"],
          ["conf:med", "Média"],
          ["conf:low", "Baixa"],
        ].forEach(([value, label]) => {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          confidenceSelect.appendChild(option);
        });
        confidenceSelect.value = state.filters.conf?.[0] || "";

        const reviewLabel = document.createElement("label");
        reviewLabel.className = "check-option";
        const reviewCheckbox = document.createElement("input");
        reviewCheckbox.type = "checkbox";
        reviewCheckbox.name = "needs_review";
        reviewCheckbox.value = "1";
        reviewCheckbox.checked = state.filters.needs_review?.includes("1") || false;
        reviewLabel.append(reviewCheckbox, document.createTextNode("Somente pendentes de revisão"));

        const letterCounts = await fetchJSON(`${assetBase}data/${dataVolume}/dict/lemmas-first-letter.json`);
        const lettersWrap = document.createElement("div");
        lettersWrap.className = "chips alphabet-chips";
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").forEach((letter) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "chip alphabet-chip";
          button.dataset.letter = letter;
          button.setAttribute("aria-pressed", String(state.filters.first_letter?.includes(letter) || false));
          if (state.filters.first_letter?.includes(letter)) button.classList.add("active");
          button.textContent = letterCounts[letter] ? `${letter}` : letter;
          if (!letterCounts[letter]) button.disabled = true;
          lettersWrap.appendChild(button);
        });

        filtersRoot.innerHTML = "";
        filtersRoot.classList.remove("filters-panel--open");
        const filtersHeader = document.createElement("div");
        filtersHeader.className = "filters-panel-header";
        const filtersHeading = document.createElement("h2");
        filtersHeading.textContent = "Refinar consulta";
        const filtersToggle = document.createElement("button");
        filtersToggle.type = "button";
        filtersToggle.className = "button secondary filters-mobile-toggle";
        filtersToggle.setAttribute("aria-controls", "filters-panel");
        filtersToggle.setAttribute("aria-expanded", "false");
        filtersToggle.textContent = "Mostrar filtros";
        filtersHeader.append(filtersHeading, filtersToggle);
        const filtersStack = document.createElement("div");
        filtersStack.className = "filters-stack";
        filtersStack.append(
          createSection("Dicionário", volumeSelect),
          createSection("Classe gramatical", morphologyWrap),
          createSection("Inicial", lettersWrap),
          createSection("Confiança da revisão", confidenceSelect),
          createSection("Estado editorial", reviewLabel),
        );
        const clearButton = document.createElement("button");
        clearButton.type = "button";
        clearButton.className = "button secondary filters-clear";
        clearButton.id = "clear-filters";
        clearButton.textContent = "Limpar filtros";
        filtersRoot.append(filtersHeader, filtersStack, clearButton);

        await loadSuggestions(dataVolume);

        filtersToggle.addEventListener("click", () => {
          const isOpen = filtersRoot.classList.toggle("filters-panel--open");
          filtersToggle.setAttribute("aria-expanded", String(isOpen));
          filtersToggle.textContent = isOpen ? "Ocultar filtros" : "Mostrar filtros";
        });

        volumeSelect.addEventListener("change", async () => {
          if (volumeSelect.value) state.filters.volume_id = [volumeSelect.value];
          else delete state.filters.volume_id;
          delete state.filters.morfologia;
          delete state.filters.first_letter;
          state.page = 1;
          syncUrl();
          await loadFilters();
          render();
        });

        morfNodes = Array.from(morphologyWrap.querySelectorAll("input[type='checkbox']"));
        morfNodes.forEach((checkbox) => checkbox.addEventListener("change", () => {
          const selected = morfNodes.filter((node) => node.checked).map((node) => node.value);
          if (selected.length) state.filters.morfologia = selected;
          else delete state.filters.morfologia;
          state.page = 1;
          syncUrl();
          render();
        }));

        letterNodes = Array.from(lettersWrap.querySelectorAll("button.chip"));
        letterNodes.forEach((button) => button.addEventListener("click", () => {
          const wasActive = button.classList.contains("active");
          letterNodes.forEach((node) => {
            node.classList.remove("active");
            node.setAttribute("aria-pressed", "false");
          });
          if (wasActive) delete state.filters.first_letter;
          else {
            button.classList.add("active");
            button.setAttribute("aria-pressed", "true");
            state.filters.first_letter = [button.dataset.letter];
          }
          state.page = 1;
          syncUrl();
          render();
        }));

        confidenceSelect.addEventListener("change", () => {
          if (confidenceSelect.value) state.filters.conf = [confidenceSelect.value];
          else delete state.filters.conf;
          state.page = 1;
          syncUrl();
          render();
        });

        reviewCheckbox.addEventListener("change", () => {
          if (reviewCheckbox.checked) state.filters.needs_review = ["1"];
          else delete state.filters.needs_review;
          state.page = 1;
          syncUrl();
          render();
        });

        clearButton.addEventListener("click", async () => {
          state.filters = {};
          state.page = 1;
          syncUrl();
          await loadFilters();
          render();
        });
      } catch (error) {
        filtersRoot.innerHTML = '<p class="muted">Os filtros estão temporariamente indisponíveis.</p>';
        console.error(error);
      }
    }

    function updateSuggestions() {
      const query = normalizeLemma(searchBox.value);
      datalist.replaceChildren();
      if (query.length < 2 || allLemmas.length === 0) return;

      const matches = allLemmas
        .filter((lemma) => normalizeLemma(lemma).includes(query))
        .sort((a, b) => {
          const aStarts = normalizeLemma(a).startsWith(query) ? 0 : 1;
          const bStarts = normalizeLemma(b).startsWith(query) ? 0 : 1;
          return aStarts - bStarts || a.localeCompare(b, "la");
        })
        .slice(0, 15);

      matches.forEach((lemma) => {
        const option = document.createElement("option");
        option.value = lemma;
        datalist.appendChild(option);
      });
    }

    async function searchRecords(pagefind, term) {
      const baseOptions = { filters: filterExpression() };
      if (!term) {
        const response = await pagefind.search(null, {
          ...baseOptions,
          sort: { lemma: "asc" },
        });
        return { results: response?.results || [], exactIds: new Set(), morphologyMatches: new Map() };
      }

      const exactKey = normalizeLemma(term);
      const cachedMorphology = morphologyCache.get(morphologyKey(term));
      const morphologyLemmas = (cachedMorphology?.lemmas || []).filter(({key}) => key !== exactKey);
      const [exactResponse, broadResponse, ...lemmaResponses] = await Promise.all([
        exactKey
          ? pagefind.search(null, { filters: filterExpression({ lemma_exact: [exactKey] }) })
          : Promise.resolve({ results: [] }),
        pagefind.search(term, baseOptions),
        ...morphologyLemmas.map(({key}) =>
          pagefind.search(null, {filters: filterExpression({lemma_exact: [key]})})
        ),
      ]);

      const exactResults = exactResponse?.results || [];
      const broadResults = broadResponse?.results || [];
      const exactIds = new Set(exactResults.map((result) => result.id));
      const morphologyMatches = new Map();
      const morphologyResults = [];
      lemmaResponses.forEach((response, index) => {
        (response?.results || []).forEach((result) => {
          morphologyResults.push(result);
          if (!morphologyMatches.has(result.id)) morphologyMatches.set(result.id, new Set());
          morphologyMatches.get(result.id).add(morphologyLemmas[index].label);
        });
      });
      const seen = new Set();
      const merged = [...exactResults, ...morphologyResults, ...broadResults].filter((result) => {
        if (seen.has(result.id)) return false;
        seen.add(result.id);
        return true;
      });
      return { results: merged, exactIds, morphologyMatches };
    }

    function volumeTitle(volumeId) {
      return volumes.find((volume) => String(volume.volume_id ?? volume.id) === String(volumeId))?.title || volumeId || "";
    }

    function renderCard(hit, category, relatedLemmas = []) {
      const isExact = category === "exact";
      const isMorphology = category === "morphology";
      const card = document.createElement("article");
      card.className = `result-card${isExact ? " result-card--exact" : ""}${isMorphology ? " result-card--morphology" : ""}`;

      const heading = document.createElement("h3");
      heading.className = "result-title";
      const link = document.createElement("a");
      link.href = normalizeUrl(hit.url || "#");
      link.textContent = hit.meta?.title || hit.meta?.lemmas || "Verbete";
      heading.appendChild(link);

      const meta = document.createElement("div");
      meta.className = "result-meta";
      if (isExact) {
        const exactBadge = document.createElement("span");
        exactBadge.className = "badge badge--exact";
        exactBadge.textContent = "Entrada exata";
        meta.appendChild(exactBadge);
      }
      if (isMorphology) {
        const morphologyBadge = document.createElement("span");
        morphologyBadge.className = "badge badge--morphology";
        morphologyBadge.textContent = `Lema reconhecido: ${relatedLemmas.join(", ")}`;
        meta.appendChild(morphologyBadge);
      }
      if (hit.meta?.morfologia) {
        const morphologyBadge = document.createElement("button");
        morphologyBadge.type = "button";
        morphologyBadge.className = "badge badge--clickable";
        morphologyBadge.textContent = hit.meta.morfologia;
        morphologyBadge.title = "Filtrar por esta classe gramatical";
        morphologyBadge.addEventListener("click", () => {
          state.filters.morfologia = [hit.meta.morfologia];
          state.page = 1;
          syncUrl();
          loadFilters().then(render);
        });
        meta.appendChild(morphologyBadge);
      }
      if (hit.meta?.redirect_only === "1") {
        const redirectBadge = document.createElement("span");
        redirectBadge.className = "badge";
        redirectBadge.textContent = "Remissiva";
        meta.appendChild(redirectBadge);
      }
      if (hit.meta?.needs_review === "1") {
        const reviewBadge = document.createElement("span");
        reviewBadge.className = "badge badge--warning";
        reviewBadge.textContent = "Revisão pendente";
        meta.appendChild(reviewBadge);
      }

      const excerpt = document.createElement("p");
      excerpt.className = "result-excerpt";
      if (hit.excerpt) excerpt.innerHTML = hit.excerpt;
      else excerpt.textContent = (hit.content || "Sem definição disponível.").slice(0, 240);

      const source = document.createElement("p");
      source.className = "result-source muted";
      const sourceParts = [volumeTitle(hit.meta?.volume_id)];
      if (hit.meta?.page_num) sourceParts.push(`p. ${hit.meta.page_num}`);
      source.textContent = sourceParts.filter(Boolean).join(" · ");

      card.append(heading, meta, excerpt, source);
      return card;
    }

    function createPagination(totalPages) {
      const pagination = document.createElement("nav");
      pagination.className = "pagination";
      pagination.setAttribute("aria-label", "Paginação dos resultados");

      const previous = document.createElement("button");
      previous.type = "button";
      previous.className = "pagination-button";
      previous.textContent = "← Anterior";
      previous.disabled = state.page === 1;

      const label = document.createElement("span");
      label.className = "pagination-label";
      label.textContent = `${state.page} de ${totalPages}`;

      const next = document.createElement("button");
      next.type = "button";
      next.className = "pagination-button";
      next.textContent = "Próxima →";
      next.disabled = state.page === totalPages;

      const changePage = (page) => {
        state.page = page;
        syncUrl();
        render().then(() => resultsTitle.scrollIntoView({ behavior: "smooth", block: "start" }));
      };
      previous.addEventListener("click", () => changePage(Math.max(1, state.page - 1)));
      next.addEventListener("click", () => changePage(Math.min(totalPages, state.page + 1)));

      pagination.append(previous, label, next);
      return pagination;
    }

    async function render({preserveResults = false} = {}) {
      const sequence = ++renderSequence;
      const term = state.term.trim();
      const hasFilters = Object.keys(state.filters).length > 0;

      if (term) requestMorphology(term);
      else morphologyPanel.hidden = true;

      resultsTitle.textContent = term ? `Resultados para “${term}”` : hasFilters ? "Verbetes filtrados" : "Índice alfabético";
      resultsSummary.textContent = "Consultando o índice…";
      if (!preserveResults) {
        resultsEl.innerHTML = '<div class="loading-state" role="status"><span class="loading-dot" aria-hidden="true"></span> Buscando…</div>';
      }

      try {
        const pagefind = await ensurePagefind();
        const { results, exactIds, morphologyMatches } = await searchRecords(pagefind, term);
        if (sequence !== renderSequence) return;

        const total = results.length;
        if (total === 0) {
          resultsSummary.textContent = "Nenhum verbete encontrado";
          resultsEl.innerHTML = "";
          const empty = document.createElement("div");
          empty.className = "empty-state";
          const heading = document.createElement("h3");
          heading.textContent = "Nenhum resultado";
          const copy = document.createElement("p");
          copy.className = "muted";
          copy.textContent = "Tente retirar um filtro, conferir a grafia ou buscar apenas o início do lema.";
          empty.append(heading, copy);
          resultsEl.appendChild(empty);
          return;
        }

        const totalPages = Math.max(1, Math.ceil(total / state.pageSize));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * state.pageSize;
        const end = Math.min(start + state.pageSize, total);
        const pageRows = results.slice(start, end);
        const hits = await Promise.all(pageRows.map(async (result) => ({
          data: await result.data(),
          category: exactIds.has(result.id)
            ? "exact"
            : morphologyMatches.has(result.id) ? "morphology" : "broad",
          relatedLemmas: [...(morphologyMatches.get(result.id) || [])],
        })));
        if (sequence !== renderSequence) return;

        const expandedLemmas = morphologyCache.get(morphologyKey(term))?.lemmas || [];
        const expansionSummary = expandedLemmas.length
          ? ` · consulta ampliada por ${expandedLemmas.map(({label}) => label).join(", ")}`
          : "";
        resultsSummary.textContent = `${total.toLocaleString("pt-BR")} ${total === 1 ? "verbete" : "verbetes"} · exibindo ${start + 1}–${end}${expansionSummary}`;
        resultsEl.innerHTML = "";

        if (totalPages > 1) resultsEl.appendChild(createPagination(totalPages));
        const list = document.createElement("div");
        list.className = "result-cards";
        hits.forEach((hit, index) => {
          if (hit.category !== hits[index - 1]?.category && hit.category === "morphology") {
            const divider = document.createElement("p");
            divider.className = "result-group-label";
            divider.textContent = "Verbetes dos lemas identificados";
            list.appendChild(divider);
          }
          if (index > 0 && hit.category !== hits[index - 1]?.category && hit.category === "broad") {
            const divider = document.createElement("p");
            divider.className = "result-group-label";
            divider.textContent = "Outras ocorrências e formas relacionadas";
            list.appendChild(divider);
          }
          list.appendChild(renderCard(hit.data, hit.category, hit.relatedLemmas));
        });
        resultsEl.appendChild(list);
        if (totalPages > 1) resultsEl.appendChild(createPagination(totalPages));
      } catch (error) {
        if (sequence !== renderSequence) return;
        console.error(error);
        resultsSummary.textContent = "Não foi possível consultar o índice";
        resultsEl.innerHTML = '<div class="empty-state"><h3>Erro ao buscar</h3><p class="muted">Recarregue a página e tente novamente.</p></div>';
      }
    }

    function handleTermInput(immediate = false) {
      state.term = searchBox.value;
      state.page = 1;
      syncUrl();
      updateSuggestions();
      clearTimeout(debounceTimer);
      if (immediate) render();
      else debounceTimer = setTimeout(render, 280);
    }

    searchForm.addEventListener("submit", (event) => {
      event.preventDefault();
      handleTermInput(true);
    });
    searchBox.addEventListener("input", () => handleTermInput(false));
    searchBox.addEventListener("focus", () => ensurePagefind().catch(() => {}), { once: true });
    pageSizeSel.addEventListener("change", () => {
      const value = parseInt(pageSizeSel.value, 10);
      state.pageSize = Number.isNaN(value) ? 25 : value;
      state.page = 1;
      syncUrl();
      render();
    });
    window.addEventListener("popstate", () => {
      state.filters = {};
      qsParamsToState();
      searchBox.value = state.term;
      pageSizeSel.value = String(state.pageSize);
      loadFilters().then(render);
    });

    loadFilters().finally(() => render());
    const scheduleMorphology = window.requestIdleCallback || ((callback) => window.setTimeout(callback, 800));
    scheduleMorphology(() => startMorphologyWorker());
  </script>
</Layout>
