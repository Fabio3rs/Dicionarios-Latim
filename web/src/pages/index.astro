---
import Layout from "../components/Layout.astro";
import "../styles/base.css";

const base = import.meta.env.BASE_URL || "/Dicionarios-Latim";
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;

const stats = [
  { value: "29k+", label: "Verbetes" },
  { value: "1k+", label: "Páginas processadas" },
  { value: "1", label: "Volume inicial (Faria)" },
  { value: "100%", label: "Busca offline baixando o repositório" },
];

const startPoints = {
  "Autores": [
    { label: "Cícero", term: "Cicero" },
    { label: "Virgílio", term: "Virgilius" },
    { label: "Horácio", term: "Horatius" },
  ],
  "Temas": [
    { label: "Gramática", term: "grammatica" },
    { label: "Retórica", term: "rhetorica" },
    { label: "História", term: "historia" },
  ],
};
---

<Layout title="Dicionários Latim-Português" description="Interface de busca estática para os dicionários processados.">
  <Fragment slot="head">
    <link rel="prefetch" href={`${baseWithSlash}search`} />
    <link rel="prefetch" href={`${baseWithSlash}pagefind/pagefind.js`} />
  </Fragment>

  <section class="card hero-card">
    <p class="eyebrow hero-label">Projeto Lexicon</p>
    <h1 class="hero-title">Encontre uma palavra em latim</h1>
    <p class="hero-desc">
      Consulte os verbetes do <strong>Dicionário Escolar Latim-Português (Faria)</strong> pelo lema,
      pela tradução ou pelo texto da definição.
    </p>
    <form class="home-search-form" action={`${baseWithSlash}search`} method="get" role="search">
      <label class="sr-only" for="home-search">Consultar o dicionário</label>
      <input id="home-search" class="input home-search-input" type="search" name="term" placeholder="Digite um lema, como amo…" autocomplete="off" />
      <button class="button home-search-button" type="submit">Consultar</button>
    </form>
    <p class="home-search-hint muted">Experimente: <a href={`${baseWithSlash}search?term=amo`}>amo</a>, <a href={`${baseWithSlash}search?term=bellum`}>bellum</a> ou <a href={`${baseWithSlash}search?term=sum`}>sum</a>.</p>
  </section>

  <section class="card-plain stats-section">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-item">
          <h3 class="stat-value">{s.value}</h3>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="card start-points-section">
    <header class="start-points-header">
      <div>
        <p class="muted start-points-label">Pontos de partida</p>
        <h2 class="start-points-title">Sugestões rápidas</h2>
      </div>
      <a href={`${baseWithSlash}search`}>Ver índice alfabético →</a>
    </header>
    <div class="start-points-grid">
      {Object.entries(startPoints).map(([title, links]) => (
        <div>
          <h3 class="start-points-category">{title}</h3>
          <ul>
            {links.map((link) => (
              <li><a href={`${baseWithSlash}search?term=${encodeURIComponent(link.term)}`}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
