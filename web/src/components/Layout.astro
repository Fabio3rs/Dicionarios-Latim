---
import "../styles/base.css";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title = "Dicionários", description = "", breadcrumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL || "/Dicionarios-Latim";
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="pt-BR" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseWithSlash}favicon.svg`} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Script bloqueante: aplica tema antes do primeiro paint para evitar FOUC -->
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem("theme");
          const valid = ["light", "dark", "auto"];
          const theme = valid.includes(t) ? t : "auto";
          // Armazena a escolha do utilizador para o ThemeToggle lê-la
          document.documentElement.dataset.themeChoice = theme;
          // Aplica o tema visual efectivo
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const effective = theme === "auto" ? (prefersDark ? "dark" : "light") : theme;
          document.documentElement.setAttribute("data-theme", effective);
        } catch (_) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <a class="site-brand" href={baseWithSlash} aria-label="Dicionários — página inicial">
        <span class="site-brand-mark" aria-hidden="true">D</span>
        <span>
          <strong>Dicionários</strong>
          <small>Latim–português</small>
        </span>
      </a>
      <div class="site-header-actions">
        <nav class="site-nav" aria-label="Navegação principal">
          <a href={`${baseWithSlash}search`}>Consultar</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="conteudo" class="page">
      <details class="project-notice">
        <summary>Sobre a edição e a qualidade dos dados</summary>
        <p>Projeto pessoal para estudos de LLM/OCR. Os verbetes foram processados por pipeline automatizada e ainda não passaram por revisão humana completa.</p>
      </details>
      {breadcrumbs.length ? (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {breadcrumbs.map((b, i) => (
            <>
              {i > 0 && <span class="sep">/</span>}
              {b.href ? <a href={b.href}>{b.label}</a> : <span>{b.label}</span>}
            </>
          ))}
        </nav>
      ) : null}
      <slot />
    </main>
  </body>
</html>
